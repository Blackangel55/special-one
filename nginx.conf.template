server {
    listen       ${PORT};
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache images a little, never cache the page itself
    location ~* \.(jpg|jpeg|png|gif|webp|svg)$ {
        expires 1h;
        add_header Cache-Control "public";
    }
}
